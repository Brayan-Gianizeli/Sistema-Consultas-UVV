@model WebApplication1.Models.Usuario

@{
    ViewData["Title"] = "Cadastro de Usuário";
}

<form asp-action="Cadastro" method="post">

    <h1>Cadastro de Usuário</h1>

    <div>
        <label asp-for="Nome">Nome</label>
        <input asp-for="Nome" />
        <span asp-validation-for="Nome"></span>
    </div>

    <div>
        <label asp-for="Email">E-mail</label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label asp-for="Senha">Senha</label>
        <input asp-for="Senha" type="password" />
        <span asp-validation-for="Senha"></span>
    </div>

    <button type="submit">Cadastrar</button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}