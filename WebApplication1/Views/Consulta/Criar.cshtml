@model WebApplication1.Models.Consulta

@{
    ViewData["Title"] = "Nova Consulta";
}

<form asp-action="Criar" method="post">

    <h1>Nova Consulta</h1>

    <div>
        <label asp-for="Especialidade">Especialidade</label>
        <input asp-for="Especialidade" />
        <span asp-validation-for="Especialidade"></span>
    </div>

    <div>
        <label asp-for="DataHora">Data e Hora</label>
        <input asp-for="DataHora" type="datetime-local" />
        <span asp-validation-for="DataHora"></span>
    </div>

    <div>
        <label asp-for="Descricao">Descrição</label>
        <textarea asp-for="Descricao"></textarea>
        <span asp-validation-for="Descricao"></span>
    </div>

    <button type="submit">Salvar Consulta</button>

    <a asp-action="Index">Voltar</a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}